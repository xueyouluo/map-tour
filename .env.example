# Text and screenshots share this OpenAI-compatible multimodal model.
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com

AMAP_JSAPI_KEY=
AMAP_SECURITY_JS_CODE=
# Optional: published custom style ID from the AMap style editor.
AMAP_MAP_STYLE_ID=
PORT=8787
SQLITE_DB_PATH=data/map-tour.sqlite

# Video generation: requires installed Chrome/Chromium, ffmpeg, ffprobe and curl.
VIDEO_EXPORT_ENABLED=true
VIDEO_EXPORT_DIR=data/video-exports
# Optional: normalized built-in music catalog (created with npm run music:import).
# VIDEO_MUSIC_DIR=/absolute/path/to/assets/music
# VIDEO_CHROME_PATH=/absolute/path/to/chrome
# VIDEO_CACHE_DIR=/absolute/path/to/video-cache
# Shared public map tiles only; active readers defer eviction until safe.
VIDEO_CACHE_MAX_MB=512
VIDEO_CACHE_TTL_DAYS=7

# Admin-only web settings are saved to data/local-settings.json and override .env.
# Optional alternative local settings file (restart required).
# SETTINGS_FILE=data/local-settings.json

# Accounts: registration creates ordinary users with 3 cumulative itineraries.
USER_REGISTRATION_ENABLED=true
# First admin: open /admin/setup directly on localhost, or set a random token
# of at least 24 characters to initialize over HTTPS, then remove the token.
# ADMIN_SETUP_TOKEN=
# Optional HTTPS directory of the same hashed MP3 files on object storage/CDN.
# Must allow browser CORS GET/HEAD; downloads go directly to this host.
# VIDEO_MUSIC_CDN_URL=https://cdn.example.com/map-tour/music/
